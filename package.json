{
  "name": "youtube-player-electron",
  "main": "main.js",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "build": {
    "appId": "com.yourdomain.youtube-player",
    "productName": "YouTube Player",
    "files": [
      "build/**/*",
      "main.js",
      "preload.js"
    ],
    "extraFiles": [
      {
        "from": "src/utils/pydownloader",
        "to": "pydownloader",
        "filter": ["**/*"]
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "asar": true,
    "asarUnpack": ["extraResources/**/*"],
    "mac": {
      "category": "public.app-category.music",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@ffmpeg/ffmpeg": "0.10.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@react-oauth/google": "^0.12.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/electron": "^1.6.12",
    "@types/howler": "^2.2.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",

    "howler": "^2.2.4",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1",
    "web-vitals": "^2.1.4",
    "zustand": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "electron-start": "ELECTRON_START_URL=http://localhost:3000 electron .",
    "electron-build": "npm run build && electron .",
    "predist": "npm run build",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/ffmpeg": "^1.0.7",
    "@types/path-browserify": "^1.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^24.9.1"
  }
}
